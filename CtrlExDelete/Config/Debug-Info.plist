<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DEBUG BUILDS ONLY (INFOPLIST_FILE for the Debug configuration).
  NSAllowsLocalNetworking lets a physical iPhone reach the FastAPI server on
  your Mac over plain http while developing. CEDDevServerHost/Port come from
  Config/Debug.xcconfig and your DeveloperSettings.xcconfig.
  Release builds don't use this file, so they require HTTPS.
-->
<plist version="1.0">
<dict>
	<key>CEDDevServerHost</key>
	<string>$(CED_DEV_SERVER_HOST)</string>
	<key>CEDDevServerPort</key>
	<string>$(CED_DEV_SERVER_PORT)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
