// Copy this file to DeveloperSettings.xcconfig (same folder; it's gitignored)
// to change Debug builds on YOUR Mac only. Without it, Debug builds use the
// deployed Render backend, like Release builds.
//
// Local development: uncomment CED_BACKEND = local to use the FastAPI server
// on your Mac (run it with --host 0.0.0.0 for an iPhone). The Simulator
// reaches it at 127.0.0.1; an iPhone needs your Mac's address below:
// System Settings > General > Sharing > Local hostname (or run
// `scutil --get LocalHostName` and add ".local"). It keeps working when your
// Wi-Fi gives the Mac a new IP. An IP address also works, until it changes.
//
// The [sdk=iphoneos*] part applies the host to physical devices only, so the
// Simulator keeps using 127.0.0.1. Rebuild and run once from Xcode after
// changing anything here. Host only, no http:// ("//" starts a comment here).

// CED_BACKEND = local
CED_DEV_SERVER_HOST[sdk=iphoneos*] = Your-Mac-Name.local
// CED_DEV_SERVER_PORT = 8000
