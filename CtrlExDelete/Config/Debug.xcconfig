// Debug build settings for the CtrlExDelete target (Release doesn't use this file).
//
// Which backend Debug builds use. "deployed" is the Render server (the same
// as Release; its address is APIConfig.deployedBaseURL). It's built into the
// app, so it also applies when the app is opened from the Home Screen.
//
// To use the FastAPI server on your Mac instead, don't change it here: copy
// DeveloperSettings.example.xcconfig to DeveloperSettings.xcconfig (gitignored,
// one per Mac) and set CED_BACKEND = local there. The Simulator reaches the
// Mac at 127.0.0.1; a physical iPhone needs your Mac's address
// (CED_DEV_SERVER_HOST).
//
// Only the host goes here, without http://: "//" starts a comment in xcconfig files.

CED_BACKEND = deployed
CED_DEV_SERVER_HOST = 127.0.0.1
CED_DEV_SERVER_PORT = 8000

#include? "DeveloperSettings.xcconfig"
