// Debug build settings for the CtrlExDelete target (Release doesn't use this file).
//
// Where Debug builds find the FastAPI backend. The address is built into the
// app, so it also works when the app is opened from the Home Screen, without
// Xcode. The Simulator shares the Mac's network, so 127.0.0.1 works there.
//
// A physical iPhone needs YOUR Mac's address. Don't change it here: copy
// DeveloperSettings.example.xcconfig to DeveloperSettings.xcconfig (gitignored,
// one per Mac) and set it there.
//
// Only the host goes here, without http://: "//" starts a comment in xcconfig files.

CED_DEV_SERVER_HOST = 127.0.0.1
CED_DEV_SERVER_PORT = 8000

#include? "DeveloperSettings.xcconfig"
