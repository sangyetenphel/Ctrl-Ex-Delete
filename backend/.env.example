DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
AWS_ACCESS_KEY_ID=your-key-id
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=us-east-2
S3_BUCKET=ced-test-bucket
# Optional, local testing only: an S3-compatible server such as MinIO.
# S3_ENDPOINT_URL=http://127.0.0.1:9000

# Ced (AI chat). The key stays on the server; never put it in the app.
GROQ_API_KEY=your-groq-key
# Optional (these are the defaults):
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-120b   (GROQ_MODEL also works)
# CED_DAILY_MESSAGE_LIMIT=60

# Ced voice calls (Gemini Live). The key stays on the server.
GEMINI_API_KEY=your-gemini-key
# Optional (these are the defaults):
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_VOICE=Vindemiatrix
# CED_VOICE_MAX_MINUTES=15  # per call
# CED_VOICE_MAX_CONCURRENT=3  # calls at once, whole server
# CED_VOICE_CALLS_PER_HOUR=30  # calls started, whole server
# CED_VOICE_DIAGNOSTICS=true  # privacy-safe call states/counts in the log
